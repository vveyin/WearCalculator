<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.

         本地构建说明：这几个 colorPrimaryVariant / colorOnPrimary / colorSecondary /
         colorSecondaryVariant / colorOnSecondary 不是 framework 属性，只有依赖
         material 或 appcompat 时才存在。本地为了压低依赖把 material 去掉了，
         所以这里只保留 framework 真正认识的部分。
         完整的原文件备份在 tools/themes.xml.orig，恢复官方配置时拷回去即可。 -->
    <style name="Theme.WearCalculator" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">@font/misans_regular</item>
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>
</resources>
